{
	"hooks": {
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PROJECT_DIR}/tools/memory-check.js"
						]
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PROJECT_DIR}/tools/ensure-relay-daemon.js"
						]
					}
				]
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PROJECT_DIR}/tools/memory-session-start.js"
						]
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PROJECT_DIR}/pipelines/deploy/lib/secret-scan-gate.js"
						]
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PROJECT_DIR}/tools/memory-work-marker.js"
						]
					}
				]
			}
		]
	},
	"enableAllProjectMcpServers": true,
	"permissions": {
		"allow": [
			"Bash(npm run task -- read:*)",
			"Bash(npm run task -- list:*)",
			"Bash(npm run task -- transition:*)",
			"Bash(npm run task -- update-field:*)",
			"Bash(npm run task -- waves:*)",
			"Bash(npm run task -- append-section:*)",
			"Bash(npm run task -- qa-report:*)",
			"Bash(npm run task -- post-merge-check:*)",
			"Bash(npm run task -- dispatch-context:*)",
			"Bash(npm run task -- create:*)"
		]
	}
}
