{
	"hooks": {
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/tools/memory-check.sh\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/tools/ensure-relay-daemon.js\""
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PROJECT_DIR}/pipelines/deploy/lib/secret-scan-gate.js"
						]
					}
				]
			}
		]
	},
	"enableAllProjectMcpServers": true
}
