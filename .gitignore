# Scratch outputs. Root-anchored: an unanchored name would match vault/Tmp, vault/Dist,
# vault/Logs and vault/Projects on a case-insensitive filesystem.
/tmp/
/dist/
coverage/
node_modules/
# Relay daemon runtime scratch (inbox, logs) lives only at the hub root; an
# unanchored rule would also swallow the shipped pipelines/deploy/relay/ module.
# memory-index CLI local index — regenerated via `npm run memory-index -- build`
.memory-index.json
dev-server.log
# dep-graph MCP baseline() output, written next to the scanned directory
workspace-identity.mdc
copilot-instructions.md
# Generated by deploy (hooks, MCP, permissions); regenerated on every deploy and
# accumulates local permissions.allow entries, so it differs per clone
.env
# Setup-owned: created from the shipped pipelines/deploy/templates/hub-mcp.json, then
# gains the machine-specific qmd entry. Anchored so the template stays tracked.
/.mcp.json
# Obsidian per-user state: ignore everything under vault/.obsidian/ except the code of
# the three shipped plugins. Contents-plus-negation: a directory that is itself ignored
# cannot be re-included. Every plugin's data.json (the REST API plugin's holds the API
# key, a certificate and its private key), user-installed plugins, workspace.json,
# graph.json and the plugin config files stay out; setup recreates the two plugin
# config files from templates/vault-plugin-config/.
/vault/.obsidian/*
!/vault/.obsidian/plugins/
/vault/.obsidian/plugins/*
!/vault/.obsidian/plugins/colorful-folders/
/vault/.obsidian/plugins/colorful-folders/*
!/vault/.obsidian/plugins/colorful-folders/main.js
!/vault/.obsidian/plugins/colorful-folders/manifest.json
!/vault/.obsidian/plugins/colorful-folders/styles.css
!/vault/.obsidian/plugins/graph-styler/
/vault/.obsidian/plugins/graph-styler/*
!/vault/.obsidian/plugins/graph-styler/main.js
!/vault/.obsidian/plugins/graph-styler/manifest.json
!/vault/.obsidian/plugins/graph-styler/styles.css
!/vault/.obsidian/plugins/obsidian-local-rest-api/
/vault/.obsidian/plugins/obsidian-local-rest-api/*
!/vault/.obsidian/plugins/obsidian-local-rest-api/main.js
!/vault/.obsidian/plugins/obsidian-local-rest-api/manifest.json
!/vault/.obsidian/plugins/obsidian-local-rest-api/styles.css
/logs/
# Free-tier learnings store: local session state, like memory/
.learnings/
/memory/
/projects/
.graphify/
package-lock.json
# Package-owned runtime manifests: setup runs npm ci --prefix against these locks
!/packages/obsidian-mcp-server/package-lock.json
!/packages/qmd/package-lock.json
graphify-out/
# Visual Studio per-user state
.vs/
*.suo
*.user
