# Personal files — always keep local branch version on merge, and keep
# shared memory/text assets LF so Windows checkouts do not add CR bytes.
memory/*.md                           text eol=lf merge=ours
.cursor/rules/workspace-identity.mdc  text eol=lf merge=ours

# Shell scripts and shared text must stay LF — Windows checkouts with
# autocrlf=true would otherwise inject CR bytes that break adapter output.
tools/*.sh    text eol=lf
tools/*.txt   text eol=lf
